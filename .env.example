# Copy this file to ".env" on the Windows PC and fill in real values.
# Never share .env or commit it anywhere.

# Free local model via Ollama (default). No API bill.
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:1.5b
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1

# Optional paid/cloud providers instead of Ollama:
# LLM_PROVIDER=groq
# GROQ_API_KEY=gsk_...
# LLM_MODEL=openai/gpt-oss-120b   (great quality + speed on the free tier)
# Pick any model available to your key at https://console.groq.com/models

# Keep only this many conversation turns in context per reply (faster + bounded).
# MAX_HISTORY_MESSAGES=24

# A long random password YOU make up - this is what the Vercel chat page uses.
# Generate one with: powershell -Command "[guid]::NewGuid().ToString()"
# Use the SAME value as AGENT_TOKEN in the Vercel project env vars.
# SECURITY WARNING: Never use the placeholder value below. Generate a secure random token.
# AGENT_TOKEN=YOUR_SECURE_RANDOM_TOKEN_HERE

# Neon connection string. The worker can use the pooled or direct URL.
# Dashboard → Connection details → copy URI (sslmode=require).
# SECURITY WARNING: Replace with your actual Neon connection string.
# DATABASE_URL=postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# Optional. Defaults to pc-main.
DEVICE_ID=pc-main

# ── Voice listener tuning (all optional, shown with defaults) ──
# VOICE_SAMPLE_RATE=16000       # Hz
# VOICE_BLOCK_SIZE=1024         # PortAudio block size
# VOICE_SILENCE_SEC=1.4         # seconds of silence before utterance ends
# VOICE_ENERGY=320              # RMS threshold to detect speech
# VOICE_MAX_BUF_SEC=30          # max utterance length before buffer is discarded
# VOICE_RECONNECT_SEC=5         # seconds to wait before reconnecting after a mic error
# GIDEON_VOICE_RATE=1           # Windows SAPI speech rate: -10 (slow) … 10 (fast)

# ── Email Integration (Gmail / Outlook / Custom IMAP & SMTP) ──
# For Gmail: Use an App Password (Google Account -> Security -> 2-Step Verification -> App passwords)
# SECURITY WARNING: Email credentials are sensitive. Only uncomment and fill these if you need email features.
# EMAIL_ADDRESS=your.email@gmail.com
# EMAIL_PASSWORD=your-app-password
# EMAIL_IMAP_SERVER=imap.gmail.com
# EMAIL_SMTP_SERVER=smtp.gmail.com
# EMAIL_PORT_IMAP=993
# EMAIL_PORT_SMTP=587

# ── WhatsApp Bridge (runs on local port 3001) ──
WA_BRIDGE_URL=http://127.0.0.1:3001

# ── Google Calendar Integration ──
# To enable calendar tools, create OAuth credentials at https://console.cloud.google.com
# 1. Create a project and enable the Google Calendar API
# 2. Create OAuth 2.0 credentials (Desktop app)
# 3. Download the JSON credentials file
# 4. Paste the entire JSON content as a single line below (escape quotes if needed)
# SECURITY WARNING: Never commit this. This gives access to your Google Calendar.
# GOOGLE_CREDENTIALS_JSON={"token": "...", "refresh_token": "...", "client_id": "...", "client_secret": "...", ...}

# ── Philips Hue Smart Home Integration ──
# To enable Hue control, find your Hue bridge IP and create a user via the Hue API
# 1. Discover bridge IP: https://discovery.meethue.com/
# 2. Create user: POST to http://<bridge-ip>/api with {"devicetype": "gideon#agent"}
# 3. Copy the returned username
# SECURITY WARNING: Never commit this. This gives control of your smart lights.
# HUE_BRIDGE_IP=192.168.1.100
# HUE_USERNAME=your-username-from-hue-api

